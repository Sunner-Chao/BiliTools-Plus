    "package": "electron-builder",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@vueuse/core": "^12.5.0",
    "date-fns": "^4.1.0",
    "echarts": "^6.0.0",
    "lucide-vue-next": "^0.475.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
