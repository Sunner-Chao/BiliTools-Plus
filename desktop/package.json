{
  "name": "bili-tools-desktop",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite --mode electron",
    "dev:web": "vite --mode web",
    "build": "vue-tsc --noEmit && vite build",
